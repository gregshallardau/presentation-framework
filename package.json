{
	"name": "reveal.js",
	"version": "0.1.0",
	"description": "Personal reveal.js-based presentation framework",
	"license": "MIT",
	"private": true,
	"_comment": "package name kept as 'reveal.js' so plugin/*/index.ts self-reference imports still resolve under tsc; the project/repo is 'presentation-framework'",
	"main": "vendor/reveal.js/dist/reveal.js",
	"module": "vendor/reveal.js/dist/reveal.mjs",
	"types": "vendor/reveal.js/dist/reveal.d.ts",
	"type": "module",
	"files": [
		"vendor/reveal.js/dist",
		"vendor/reveal.js/css",
		"vendor/reveal.js/js",
		"LICENSE",
		"README.md",
		"index.html"
	],
	"exports": {
		".": {
			"types": "./vendor/reveal.js/dist/reveal.d.ts",
			"import": "./vendor/reveal.js/dist/reveal.mjs",
			"require": "./vendor/reveal.js/dist/reveal.js",
			"default": "./vendor/reveal.js/dist/reveal.js"
		},
		"./reveal.css": "./vendor/reveal.js/dist/reveal.css",
		"./reset.css": "./vendor/reveal.js/dist/reset.css",
		"./theme/*": "./vendor/reveal.js/dist/theme/*",
		"./plugin/highlight/monokai.css": "./vendor/reveal.js/dist/plugin/highlight/monokai.css",
		"./plugin/highlight": {
			"types": "./vendor/reveal.js/dist/plugin/highlight.d.ts",
			"import": "./vendor/reveal.js/dist/plugin/highlight.mjs",
			"require": "./vendor/reveal.js/dist/plugin/highlight.js",
			"default": "./vendor/reveal.js/dist/plugin/highlight.js"
		},
		"./plugin/markdown": {
			"types": "./vendor/reveal.js/dist/plugin/markdown.d.ts",
			"import": "./vendor/reveal.js/dist/plugin/markdown.mjs",
			"require": "./vendor/reveal.js/dist/plugin/markdown.js",
			"default": "./vendor/reveal.js/dist/plugin/markdown.js"
		},
		"./plugin/math": {
			"types": "./vendor/reveal.js/dist/plugin/math.d.ts",
			"import": "./vendor/reveal.js/dist/plugin/math.mjs",
			"require": "./vendor/reveal.js/dist/plugin/math.js",
			"default": "./vendor/reveal.js/dist/plugin/math.js"
		},
		"./plugin/notes": {
			"types": "./vendor/reveal.js/dist/plugin/notes.d.ts",
			"import": "./vendor/reveal.js/dist/plugin/notes.mjs",
			"require": "./vendor/reveal.js/dist/plugin/notes.js",
			"default": "./vendor/reveal.js/dist/plugin/notes.js"
		},
		"./plugin/search": {
			"types": "./vendor/reveal.js/dist/plugin/search.d.ts",
			"import": "./vendor/reveal.js/dist/plugin/search.mjs",
			"require": "./vendor/reveal.js/dist/plugin/search.js",
			"default": "./vendor/reveal.js/dist/plugin/search.js"
		},
		"./plugin/zoom": {
			"types": "./vendor/reveal.js/dist/plugin/zoom.d.ts",
			"import": "./vendor/reveal.js/dist/plugin/zoom.mjs",
			"require": "./vendor/reveal.js/dist/plugin/zoom.js",
			"default": "./vendor/reveal.js/dist/plugin/zoom.js"
		}
	},
	"scripts": {
		"dev": "npm run start",
		"start": "vite",
		"edit": "vite -c vite.config.editor.js --open /__editor/",
		"build:deck": "vite build -c vite.config.deck.js",
		"prepack": "npm run build",
		"build:core": "tsc && vite build && vite build -c vite.config.styles.ts && node vendor/reveal.js/scripts/add-banner.js dist/reveal.js",
		"build:es5": "npm run build && node vendor/reveal.js/scripts/build-es5.js",
		"build:styles": "vite build -c vite.config.styles.ts",
		"build": "tsc && vite build && vite build -c vite.config.styles.ts && vite build -c vendor/reveal.js/plugin/highlight/vite.config.ts && vite build -c vendor/reveal.js/plugin/markdown/vite.config.ts && vite build -c vendor/reveal.js/plugin/math/vite.config.ts && vite build -c vendor/reveal.js/plugin/notes/vite.config.ts && vite build -c vendor/reveal.js/plugin/search/vite.config.ts && vite build -c vendor/reveal.js/plugin/zoom/vite.config.ts && node vendor/reveal.js/scripts/add-banner.js dist/reveal.js",
		"package": "node vendor/reveal.js/scripts/zip.js",
		"test": "node vendor/reveal.js/scripts/test.js",
		"lint:slides": "node scripts/lint-slide-classes.js",
		"check:vocab": "node scripts/check-shared-vocabulary.js",
		"make:slide": "node scripts/make-slide.js",
		"make:component": "node scripts/make-component.js",
		"test:editor": "node --test editor/tests/*.test.js",
		"test:editor:browser": "node editor/tests/browser/smoke.mjs"
	},
	"author": "Greg Shallard",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=20.19.0",
			"onFail": "error"
		}
	},
	"keywords": [
		"reveal",
		"slides",
		"presentation"
	],
	"dependencies": {
		"alpinejs": "^3.14.9",
		"d3": "^7.9.0",
		"gsap": "^3.13.0",
		"topojson-client": "^3.1.0"
	},
	"devDependencies": {
		"fitty": "^2.4.2",
		"glob": "^13.0.6",
		"highlight.js": "^11.11.1",
		"jszip": "^3.10.1",
		"marked": "^17.0.5",
		"marked-smartypants": "^1.1.11",
		"monaco-editor": "0.52.2",
		"node-qunit-puppeteer": "^2.2.1",
		"playwright-core": "1.56.1",
		"qunit": "^2.25.0",
		"sass": "^1.98.0",
		"typescript": "^6.0.2",
		"vite": "^8.0.3",
		"vite-plugin-dts": "^4.5.4"
	},
	"overrides": {
		"@microsoft/api-extractor": {
			"minimatch": "10.2.4"
		}
	}
}
